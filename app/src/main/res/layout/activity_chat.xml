<?xml version="1.0" encoding="utf-8"?>
<!--
    Chat interface layout.
    Features a backend status bar, a scrollable list of messages, a progress indicator,
    and a message input area with a send button.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Backend status bar: Indicates if the Python backend is Online, Offline, or being checked -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● Checking..."
        android:textSize="12sp"
        android:gravity="center"
        android:padding="4dp"
        android:background="?attr/colorSurfaceVariant" />

    <!-- Message list: Displays the conversation. Occupies all remaining space. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Spinner: Visible only when the AI is processing a request -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- Input row: Contains the text field and the send button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical">

        <!-- Message input field -->
        <EditText
            android:id="@+id/editMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:padding="12dp"
            android:background="?attr/colorSurface"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <!-- Send message button -->
        <ImageButton
            android:id="@+id/buttonSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send"
            android:src="@android:drawable/ic_menu_send"
            android:tint="?attr/colorPrimary" />
    </LinearLayout>

</LinearLayout>
